---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { slugifyStr } from "@/utils/slugify";
import { SITE } from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("blog");
  const bodyMapTags = ["AI", "HTB", "Hardware", "Network", "OSCP"].map(
    tagName => ({
      tag: slugifyStr(tagName),
      tagName,
    })
  );
  const tags = [...getUniqueTags(posts), ...bodyMapTags].filter(
    (value, index, self) =>
      self.findIndex(tag => tag.tag === value.tag) === index
  );

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(posts, tag);

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: SITE.postPerPage,
    });
  });
}

const params = Astro.params;
const { tag } = params;
const { page, tagName } = Astro.props;
---

<Layout title={`Tag: ${tagName} | ${SITE.title}`}>
  <Header />
  <Main
    pageTitle={[`Tag:`, `${tagName}`]}
    titleTransition={tag}
    pageDesc={`All the articles with the tag "${tagName}".`}
  >
    <h1 slot="title" transition:name={tag}>{`Tag:${tag}`}</h1>
    {
      page.data.length > 0 ? (
        <ul>
          {page.data.map(data => (
            <Card {...data} />
          ))}
        </ul>
      ) : (
        <section class="empty-tag-state" aria-label={`${tagName} coming soon`}>
          <div class="empty-tag-kicker">Coming soon</div>
          <p>
            This node is mapped, but the first {tagName} write-up has not landed
            yet.
          </p>
        </section>
      )
    }
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>

<style>
  .empty-tag-state {
    margin-block: 2.5rem 1rem;
    border: 1px solid color-mix(in srgb, var(--accent) 34%, transparent);
    border-radius: 0.25rem;
    background: color-mix(in srgb, #ffffff 88%, var(--muted));
    padding: 1.4rem 1.5rem;
    box-shadow: 0 0 20px color-mix(in srgb, var(--accent) 10%, transparent);
  }

  html[data-theme="dark"] .empty-tag-state {
    border-color: color-mix(in srgb, var(--accent) 42%, transparent);
    background: color-mix(in srgb, var(--background) 78%, var(--muted));
    box-shadow:
      0 0 22px color-mix(in srgb, var(--accent) 13%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .empty-tag-kicker {
    color: var(--accent);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
  }

  html[data-theme="dark"] .empty-tag-kicker {
    text-shadow: 0 0 14px color-mix(in srgb, var(--accent) 28%, transparent);
  }

  .empty-tag-state p {
    margin-top: 0.6rem;
    opacity: 0.72;
  }

  html[data-theme="dark"] .empty-tag-state p {
    color: color-mix(in srgb, var(--foreground) 82%, var(--accent));
    opacity: 0.8;
  }
</style>
