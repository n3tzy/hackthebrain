---
import { SITE } from "@/config";
type Item = { name: string; href: string };
type Props = { items?: Item[] };
const segments = Astro.url.pathname.split("/").filter(Boolean);
const labels: Record<string, string> = {
  "ai-security": "AI Security",
  "llm-security": "LLM Security",
  "ai-red-teaming": "AI Red Teaming",
  methodology: "Methodology",
  "case-studies": "Case Studies",
  posts: "Blog",
  about: "About",
  tags: "Tags",
  archives: "Archives",
  search: "Search",
};
const items = [
  { name: "Home", href: "/" },
  ...(Astro.props.items ??
    segments.map((segment, index) => ({
      name: labels[segment] ?? decodeURIComponent(segment),
      href: "/" + segments.slice(0, index + 1).join("/") + "/",
    }))),
];
const data = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    item: new URL(item.href, SITE.website).href,
  })),
};
---

<nav class="app-layout mt-8 mb-4 text-sm" aria-label="Breadcrumb">
  <ol class="flex flex-wrap gap-x-2 gap-y-1">
    {
      items.map((item, index) => (
        <li>
          {index > 0 && (
            <span aria-hidden="true" class="me-2">
              ›
            </span>
          )}
          {index === items.length - 1 ? (
            <span aria-current="page">{item.name}</span>
          ) : (
            <a
              class="underline decoration-dashed underline-offset-4"
              href={item.href}
            >
              {item.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(data).replaceAll("<", "\u003c")}
/>
